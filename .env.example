# cleankit configuration. Copy this file to .env and adjust as needed:
#   cp .env.example .env
#
# cleankit has no cloud services and needs no API keys. These variables only
# set CLI defaults. The CLI reads ./.env (or --env-file PATH) with a built-in
# parser; a real environment variable wins over the file, and a flag wins over
# both.

# Phone region for numbers without a country code (clean/suggest --region, and
# the fallback of standardize_phones). ISO 3166-1 alpha-2 code. Known regions:
# AR, BR, CA, CL, CO, CR, DO, EC, ES, FR, GT, HN, MX, NI, PA, PE, SV, US, VE.
# Default: PA (Panama).
CLEANKIT_DEFAULT_REGION=PA

# CSV delimiter for every command when --sep is not given. Default: ","
CLEANKIT_CSV_SEP=,
