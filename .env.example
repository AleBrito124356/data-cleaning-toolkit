# cleankit configuration. Copy this file to .env and adjust as needed:
#   cp .env.example .env
#
# cleankit has no cloud services and needs no API keys. These variables only
# set defaults for the CLI; every value can also be passed as a flag.

# Default phone region used by contacts.to_e164 when a number has no country
# code. Use an ISO 3166-1 alpha-2 code. LATAM-aware: PA, CO, MX, CR, GT, SV,
# HN, NI, DO, PE, CL, AR, EC, VE (plus US/CA). Default: PA (Panama).
CLEANKIT_DEFAULT_REGION=PA

# Default CSV delimiter for the CLI when --sep is not given. Default: ","
CLEANKIT_CSV_SEP=,
